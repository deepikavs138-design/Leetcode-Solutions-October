class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        int n = nums.size();
        for (int i = 0; i < n; ++i) {
            nums[i] = abs(nums[i]);
        }
        sort(nums.begin(), nums.end());
        
        long long maxScore = 0;
        int mid = n / 2;
        
        // Subtract smaller half's squares
        for (int i = 0; i < mid; ++i) {
            maxScore -= (long long)nums[i] * nums[i];
        }
        // Add larger half's squares
        for (int i = mid; i < n; ++i) {
            maxScore += (long long)nums[i] * nums[i];
        }
        
        return maxScore;
    }
};
