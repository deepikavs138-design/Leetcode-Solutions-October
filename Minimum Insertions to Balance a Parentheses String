class Solution {
public:
    int minInsertions(string s) {
        int insertions = 0;
        int open = 0;  // count of unmatched '('
        
        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '(') {
                open++;
            } else { // s[i] == ')'
                if (i + 1 < s.size() && s[i + 1] == ')') {
                    // Found "))"
                    i++; // skip the next ')'
                } else {
                    // Single ')', need one more ')'
                    insertions++;
                }
                
                if (open > 0) {
                    open--; // match with '('
                } else {
                    // No '(' available, need to insert one
                    insertions++;
                }
            }
        }
        
        // Each remaining '(' needs two ')'
        insertions += open * 2;
        
        return insertions;
    }
};
