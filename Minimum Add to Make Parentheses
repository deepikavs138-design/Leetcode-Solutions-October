class Solution {
public:
    int minAddToMakeValid(string s) {
        int open_brackets = 0;
        int insertions_needed = 0;

        for (char c : s) {
            if (c == '(') {
                open_brackets++;
            } else {
                // If we have an unmatched closing bracket
                if (open_brackets > 0) {
                    open_brackets--;
                } else {
                    insertions_needed++;
                }
            }
        }

        // Add any remaining unmatched opening brackets
        return insertions_needed + open_brackets;
    }
};
