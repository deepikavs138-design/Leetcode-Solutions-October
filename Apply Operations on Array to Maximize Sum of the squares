#include <vector>

class Solution {
public:
    int maxSum(std::vector<int>& nums, int k) {
        std::vector<int> bit_count(32, 0);
        
        // Count the frequency of each bit set across all elements
        for (int num : nums) {
            for (int i = 0; i < 32; ++i) {
                if ((num >> i) & 1) {
                    bit_count[i]++;
                }
            }
        }
        
        long long total_sum = 0;
        long long MOD = 1e9 + 7;
        
        // Greedily build the top k numbers
        for (int i = 0; i < k; ++i) {
            long long current_num = 0;
            for (int bit = 0; bit < 32; ++bit) {
                if (bit_count[bit] > 0) {
                    current_num |= (1LL << bit);
                    bit_count[bit]--;
                }
            }
            total_sum = (total_sum + (current_num * current_num) % MOD) % MOD;
        }
        
        return total_sum;
    }
};
