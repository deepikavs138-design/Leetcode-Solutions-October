class Solution {
public:
    bool checkValidString(string s) {
        int cmin = 0; // Minimum possible open parentheses
        int cmax = 0; // Maximum possible open parentheses
        
        for (char c : s) {
            if (c == '(') {
                cmax++;
                cmin++;
            } else if (c == ')') {
                cmax--;
                cmin--;
            } else if (c == '*') {
                cmax++; // Treat '*' as '('
                cmin--; // Treat '*' as ')'
            }
            
            // If max open parentheses drops below 0, it means we have too many ')'
            if (cmax < 0) return false;
            
            // Min open parentheses can't be negative, so we treat '*' as an empty string instead of ')'
            if (cmin < 0) cmin = 0;
        }
        
        // If min open parentheses is 0, all '(' are matched
        return cmin == 0;
    }
};
