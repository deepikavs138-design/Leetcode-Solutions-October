#include <vector>
#include <numeric>
#include <algorithm>

class Solution {
private:
    int getDigitSum(int n) {
        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }
        return sum;
    }

public:
    int minSwaps(std::vector<int>& nums) {
        int n = nums.size();
        
        // Store pairs of {digit_sum, value, original_index}
        std::vector<std::tuple<int, int, int>> items(n);
        for (int i = 0; i < n; ++i) {
            items[i] = {getDigitSum(nums[i]), nums[i], i};
        }
        
        // Sort based on digit sum (primary), then value (secondary tie-breaker)
        std::sort(items.begin(), items.end(), [](const auto& a, const auto& b) {
            if (std::get<0>(a) != std::get<0>(b))
                return std::get<0>(a) < std::get<0>(b);
            return std::get<1>(a) < std::get<1>(b);
        });
        
        // Find the minimum number of swaps to sort using cycle decomposition
        std::vector<bool> visited(n, false);
        int swaps = 0;
        
        for (int i = 0; i < n; ++i) {
            if (visited[i] || std::get<2>(items[i]) == i) {
                continue;
            }
            
            // Traverse the cycle
            int cycle_size = 0;
            int j = i;
            while (!visited[j]) {
                visited[j] = true;
                j = std::get<2>(items[j]);
                cycle_size++;
            }
            
            if (cycle_size > 1) {
                swaps += (cycle_size - 1);
            }
        }
        
        return swaps;
    }
};
