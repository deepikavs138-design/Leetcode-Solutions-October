#include <string>
#include <algorithm>

class Solution {
public:
    int minOperations(string s) {
        int n = s.size();
        
        // Check if the string is already sorted
        bool sorted = true;
        for (int i = 1; i < n; ++i) {
            if (s[i] < s[i - 1]) {
                sorted = false;
                break;
            }
        }
        if (sorted) return 0;
        
        // If length is 2 and not sorted, it's impossible to sort with proper substrings
        if (n == 2) return -1;
        
        char mn = *min_element(s.begin(), s.end());
        char mx = *max_element(s.begin(), s.end());
        
        // If the minimum element is already at the beginning or 
        // the maximum element is already at the end, 1 operation suffices.
        if (s[0] == mn || s[n - 1] == mx) {
            return 1;
        }
        
        // If either min or max element is in the interior (not at ends), 
        // we can place them correctly using 2 operations.
        for (int i = 1; i < n - 1; ++i) {
            if (s[i] == mn || s[i] == mx) {
                return 2;
            }
        }
        
        // Otherwise, it takes at most 3 operations.
        return 3;
    }
};
