#include <string>
#include <stack>
#include <algorithm>

class Solution {
public:
    int longestValidParentheses(std::string s) {
        int max_len = 0;
        std::stack<int> st;
        
        // Push -1 as the initial base for the next valid substring
        st.push(-1);
        
        for (int i = 0; i < s.length(); i++) {
            if (s[i] == '(') {
                // Push the index of the opening bracket
                st.push(i);
            } else {
                // Pop the top for the closing bracket
                st.pop();
                
                if (st.empty()) {
                    // If the stack is empty, this unmatched ')' becomes the new base
                    st.push(i);
                } else {
                    // Calculate the length of the current valid substring
                    max_len = std::max(max_len, i - st.top());
                }
            }
        }
        
        return max_len;
    }
};
