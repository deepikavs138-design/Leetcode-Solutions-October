#include <vector>
#include <cmath>
#include <algorithm>
#include <numeric>

class Solution {
public:
    long long minSumSquareDiff(std::vector<int>& nums1, std::vector<int>& nums2, int k1, int k2) {
        int n = nums1.size();
        long long totalK = (long long)k1 + k2;
        
        // Count frequencies of each absolute difference
        std::vector<long long> count(100001, 0);
        long long maxDiff = 0;
        
        for (int i = 0; i < n; ++i) {
            long long diff = std::abs(nums1[i] - nums2[i]);
            count[diff]++;
            maxDiff = std::max(maxDiff, diff);
        }
        
        // Greedily reduce the largest differences
        for (long long d = maxDiff; d > 0 && totalK > 0; --d) {
            if (count[d] == 0) continue;
            
            // Number of operations needed to reduce all elements with difference `d` to `d - 1`
            long long take = std::min(totalK, count[d]);
            count[d] -= take;
            count[d - 1] += take;
            totalK -= take;
        }
        
        // If we still have operations left and all differences are 0, we can just use them up (they do nothing)
        if (totalK > 0) {
            return 0;
        }
        
        // Calculate the minimum sum of squared differences
        long long result = 0;
        for (long long d = 1; d <= maxDiff; ++d) {
            if (count[d] > 0) {
                result += count[d] * d * d;
            }
        }
        
        return result;
    }
};
