#include <vector>

class Solution {
public:
    int sortPermutation(std::vector<int>& nums) {
        int res = -1;
        for (int i = 0; i < nums.size(); ++i) {
            // Check elements that are not in their correct sorted position
            if (nums[i] != i) {
                if (res == -1) {
                    res = nums[i];
                } else {
                    res &= nums[i];
                }
            }
        }
        return (res == -1) ? 0 : res;
    }
};
