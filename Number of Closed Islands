class Solution {
private:
    void dfs(int x, int y, vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        grid[x][y] = 1; // Mark as visited/water
        
        int dx[] = {0, 0, 1, -1};
        int dy[] = {1, -1, 0, 0};
        
        for (int i = 0; i < 4; ++i) {
            int nx = x + dx[i];
            int ny = y + dy[i];
            
            if (nx >= 0 && nx < n && ny >= 0 && ny < m && grid[nx][ny] == 0) {
                dfs(nx, ny, grid);
            }
        }
    }

public:
    int closedIsland(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        
        // Step 1: Sink all 0s connected to the boundary
        for (int i = 0; i < n; ++i) {
            if (grid[i][0] == 0) dfs(i, 0, grid);
            if (grid[i][m - 1] == 0) dfs(i, m - 1, grid);
        }
        for (int j = 0; j < m; ++j) {
            if (grid[0][j] == 0) dfs(0, j, grid);
            if (grid[n - 1][j] == 0) dfs(n - 1, j, grid);
        }
        
        // Step 2: Count remaining closed islands
        int closedIslandsCount = 0;
        for (int i = 1; i < n - 1; ++i) {
            for (int j = 1; j < m - 1; ++j) {
                if (grid[i][j] == 0) {
                    closedIslandsCount++;
                    dfs(i, j, grid);
                }
            }
        }
        
        return closedIslandsCount;
    }
};
