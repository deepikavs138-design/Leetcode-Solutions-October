#include <vector>
#include <numeric>

using namespace std;

class Solution {
    long long MOD = 1e9 + 7;
    vector<vector<long long>> table;

    // Helper function to calculate combinations (Pascal's Triangle)
    long long combination(int n, int k) {
        if (k == 0 || k == n) return 1;
        if (table[n][k] != -1) return table[n][k];
        return table[n][k] = (combination(n - 1, k - 1) + combination(n - 1, k)) % MOD;
    }

    long long dfs(vector<int>& nums) {
        int n = nums.size();
        if (n <= 2) return 1;

        vector<int> left, right;
        int root = nums[0];
        
        for (int i = 1; i < n; ++i) {
            if (nums[i] < root) left.push_back(nums[i]);
            else right.push_back(nums[i]);
        }

        long long left_ways = dfs(left);
        long long right_ways = dfs(right);

        // Ways to interleave left and right elements while preserving relative order
        long long ways = combination(n - 1, left.size());
        
        // Multiply by the ways to arrange elements within the left and right subtrees
        ways = (ways * left_ways) % MOD;
        ways = (ways * right_ways) % MOD;

        return ways;
    }

public:
    int numOfWays(vector<int>& nums) {
        int n = nums.size();
        table.resize(n + 1, vector<long long>(n + 1, -1));
        // Subtract 1 because the original array ordering itself is not a "reordering"
        return (dfs(nums) - 1 + MOD) % MOD;
    }
};
