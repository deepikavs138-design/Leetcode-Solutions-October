#include <vector>
#include <string>
#include <algorithm>

using namespace std;

class Solution {
    int n;
    vector<vector<int>> adj;
    vector<int> parent, depth, heavy, head, pos;
    vector<int> tree; // Segment tree over DFS order
    string node_char;
    int cur_pos;

    // First DFS to find subtree sizes, parent, depth, and heavy child
    int dfs1(int u, int p, int d) {
        parent[u] = p;
        depth[u] = d;
        int size = 1, max_sub_size = 0;
        for (int v : adj[u]) {
            if (v != p) {
                int sub_size = dfs1(v, u, d + 1);
                size += sub_size;
                if (sub_size > max_sub_size) {
                    max_sub_size = sub_size;
                    heavy[u] = v;
                }
            }
        }
        return size;
    }

    // Second DFS to set chain heads and positions for HLD
    void dfs2(int u, int h) {
        head[u] = h;
        pos[u] = cur_pos++;
        if (heavy[u] != -1) {
            dfs2(heavy[u], h);
        }
        for (int v : adj[u]) {
            if (v != parent[u] && v != heavy[u]) {
                dfs2(v, v);
            }
        }
    }

    // Segment tree operations
    void update_tree(int node, int start, int end, int idx, int val) {
        if (start == end) {
            tree[node] = val;
            return;
        }
        int mid = (start + end) / 2;
        if (idx <= mid) update_tree(2 * node, start, mid, idx, val);
        else update_tree(2 * node + 1, mid + 1, end, idx, val);
        tree[node] = tree[2 * node] ^ tree[2 * node + 1];
    }

    int query_tree(int node, int start, int end, int l, int r) {
        if (r < start || end < l) return 0;
        if (l <= start && end <= r) return tree[node];
        int mid = (start + end) / 2;
        return query_tree(2 * node, start, mid, l, r) ^ query_tree(2 * node + 1, mid + 1, end, l, r);
    }

    // Query path between u and v
    int query_path(int u, int v) {
        int res = 0;
        while (head[u] != head[v]) {
            if (depth[head[u]] > depth[head[v]]) {
                swap(u, v);
            }
            res ^= query_tree(1, 0, n - 1, pos[head[v]], pos[v]);
            v = parent[head[v]];
        }
        if (depth[u] > depth[v]) {
            swap(u, v);
        }
        res ^= query_tree(1, 0, n - 1, pos[u], pos[v]);
        return res;
    }

public:
    vector<bool> palindromePath(int n, vector<vector<int>>& edges, string s, vector<string>& queries) {
        this->n = n;
        this->node_char = s;
        adj.assign(n, vector<int>());
        for (const auto& edge : edges) {
            adj[edge[0]].push_back(edge[1]);
            adj[edge[1]].push_back(edge[0]);
        }

        parent.assign(n, -1);
        depth.assign(n, 0);
        heavy.assign(n, -1);
        head.assign(n, 0);
        pos.assign(n, 0);
        tree.assign(4 * n, 0);
        cur_pos = 0;

        dfs1(0, -1, 0);
        dfs2(0, 0);

        // Initialize segment tree with character masks
        for (int i = 0; i < n; ++i) {
            int mask = 1 << (s[i] - 'a');
            update_tree(1, 0, n - 1, pos[i], mask);
        }

        vector<bool> answer;
        for (const string& q : queries) {
            if (q[0] == 'u') {
                // "update u c"
                int space1 = q.find(' ', 7);
                int u = stoi(q.substr(7, space1 - 7));
                char c = q.back();
                node_char[u] = c;
                update_tree(1, 0, n - 1, pos[u], 1 << (c - 'a'));
            } else {
                // "query u v"
                int space1 = q.find(' ', 6);
                int u = stoi(q.substr(6, space1 - 6));
                int v = stoi(q.substr(space1 + 1));
                int mask = query_path(u, v);
                // Check if mask has at most one bit set
                answer.push_back((mask & (mask - 1)) == 0);
            }
        }

        return answer;
    }
};
